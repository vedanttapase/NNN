# Copy to backend/.env (git-ignored). Save as UTF-8. Never commit real values.

# Exact frontend origins allowed by CORS (comma-separated).
CORS_ORIGINS=http://localhost:3000

# SQLite path for local development. Production should use a persistent volume.
DATABASE_PATH=./suraksha_netra.db

# Ultralytics model name or local .pt path.
MODEL_NAME=yolov8n
CONFIDENCE_THRESHOLD=0.5

# REQUIRED to register cameras. Fernet key used to encrypt RTSP sources at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored camera sources unrecoverable. Keep it in a secrets manager.
CAMERA_SECRET_KEY=

# Upload limit for image/video detection requests.
MAX_UPLOAD_BYTES=52428800

# Experimental aspect-ratio fall heuristic creates incident records only when true.
ENABLE_FALL_HEURISTIC_INCIDENTS=false

LOG_LEVEL=INFO
